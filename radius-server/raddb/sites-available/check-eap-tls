        #         &Tunnel-Private-Group-Id = "100"  # Admin VLAN
        #     }
        # } else {
        #     update reply {
        #         &Tunnel-Type = VLAN
        #         &Tunnel-Medium-Type = IEEE-802
        #         &Tunnel-Private-Group-Id = "200"  # User VLAN
        #     }
        # }
    }
}